---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
---
<BaseLayout bodyClass="work-page" title="Selected Work — Samuel Akorta" description="Selected web development, interface design and visual communication work by Samuel Akorta.">
  <PageIntro eyebrow="Selected projects / 01—03" title="Selected Work" intro="A focused selection of publishing platforms, event experiences and visual communication—built across both design and implementation." />
  <section class="work-list shell section rule">{projects.map((project) => <ProjectCard project={project} />)}</section>
  <section class="work-closing"><div class="shell"><p class="eyebrow">Have a project in mind?</p><a href="/contact/"><span>Let’s make it<br />worth showing.</span><i aria-hidden="true">↗</i></a></div></section>
</BaseLayout>
<style>
:global(body.work-page){--paper:#f6f0e5;--paper-deep:#e8ddce;--line:#c9bfaf;background:var(--paper)}
:global(.work-page .page-intro){position:relative;min-height:calc(74svh - 6rem);align-content:center;padding-block:clamp(4rem,8vw,8rem)}:global(.work-page .page-intro)::before{content:"";position:absolute;top:clamp(3rem,6vw,6rem);left:var(--gutter);width:clamp(5rem,12vw,11rem);height:2px;background:var(--accent)}:global(.work-page .page-intro h1){max-width:72rem;font-size:clamp(5rem,10vw,10.5rem);line-height:.84}:global(.work-page .page-intro .intro){max-width:38rem}
.work-list{display:grid;grid-template-columns:1fr 1fr;gap:clamp(4rem,8vw,8rem) clamp(1.5rem,3vw,3rem);padding-top:clamp(6rem,9vw,9rem)}.work-list :global(.project-card:nth-child(2)){margin-top:clamp(4rem,9vw,9rem)}.work-list :global(.project-card:nth-child(3)){grid-column:1/-1;width:88%;justify-self:end}.work-closing{padding-block:clamp(5rem,9vw,9rem);border-top:.35rem solid var(--accent);background:var(--ink);color:var(--paper)}.work-closing a{display:flex;justify-content:space-between;align-items:end;margin-top:clamp(2.5rem,5vw,5rem);font-family:var(--font-display);font-size:clamp(4rem,9vw,9rem);line-height:.85;letter-spacing:-.06em}.work-closing i{display:grid;width:clamp(4rem,7vw,7rem);aspect-ratio:1;place-items:center;border:1px solid rgb(246 240 229/.5);border-radius:50%;font-family:var(--font-sans);font-size:.22em;font-style:normal;letter-spacing:0;transition:background var(--transition),border-color var(--transition),transform var(--transition)}.work-closing a:hover i,.work-closing a:focus-visible i{border-color:var(--accent);background:var(--accent);transform:translate(.12em,-.12em)}.work-closing a:focus-visible{outline-color:var(--paper)}
@media(max-width:750px){:global(.work-page .page-intro){min-height:auto}:global(.work-page .page-intro)::before{top:2.25rem}.work-list{grid-template-columns:1fr;padding-top:5rem}.work-list :global(.project-card:nth-child(2)){margin-top:0}.work-list :global(.project-card:nth-child(3)){grid-column:1;width:100%}.work-closing a{align-items:start}.work-closing i{width:3.75rem}}
</style>
