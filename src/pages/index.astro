---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { Image } from 'astro:assets';
import itaHero from '../assets/projects/ita/ita-hero-new.png';
import visualCover from '../assets/projects/visual/GRT2030_cover.png';
---
<BaseLayout bodyClass="homepage-experiment">
  <section class="hero shell">
    <div class="hero-kicker"><p class="eyebrow">Samuel Akorta / Accra, Ghana</p><p class="index">Portfolio &mdash; 2026</p></div>
    <div class="hero-stage">
      <h1 class="display"><span class="hero-line hero-line--web">Web</span><span class="hero-line hero-line--developer">Developer</span><span class="hero-line hero-line--graphic"><em>&amp;</em> Graphic Designer</span></h1>
      <a class="hero-work-window" href="#selected-work" aria-label="Explore selected portfolio work">
        <span class="hero-window-meta"><span>Selected work</span><span>01&mdash;03</span></span>
        <span class="hero-interface"><Image src={itaHero} alt="ITA Africa digital publishing interface" layout="full-width" quality="high" /></span>
        <span class="hero-publication"><Image src={visualCover} alt="Ghana Race to 2030 publication cover" layout="constrained" quality="high" /></span>
        <span class="hero-window-caption">Digital systems<br />&amp; visual communication</span>
        <span class="hero-window-arrow" aria-hidden="true">&nearr;</span>
      </a>
    </div>
    <div class="hero-bottom"><p>I design visual experiences and build the websites that bring them to life.</p><div class="hero-actions"><a class="hero-link" href="#selected-work">View selected work <span>&darr;</span></a><a class="hero-link" href="/contact/">Start a conversation <span>&nearr;</span></a></div></div>
  </section>

  <section class="intro"><div class="shell intro-grid"><p class="eyebrow home-reveal">Design + implementation</p><p class="intro-copy home-reveal home-reveal--mask">From visual system to working interface.</p><div class="intro-note home-reveal"><span>01 / Design</span><span>02 / Development</span><p>Visual judgment backed by production experience.</p></div></div></section>

  <section class="section shell work-section" id="selected-work"><div class="work-heading"><p class="eyebrow home-reveal">Selected work / 01&mdash;03</p><h2 class="display home-reveal home-reveal--mask">Work that lives<br />in the real world.</h2><a class="link-arrow home-reveal" href="/work/">View all projects</a></div><div class="projects">{projects.map((project) => <ProjectCard project={project} />)}</div></section>

  <section class="capabilities section">
    <div class="shell">
      <header class="capabilities-intro home-reveal"><p class="eyebrow">Capabilities / 01&mdash;02</p><p class="capabilities-thesis">One practice. Two disciplines.<br />One standard of finish.</p></header>
      <div class="practice-stack">
        <article class="discipline discipline--design home-reveal" aria-labelledby="design-title"><div class="discipline-heading"><p class="discipline-index">01 / Visual systems</p><h2 id="design-title">Design</h2></div><ul><li>Graphic Design</li><li>Editorial Systems</li><li>Campaign Design</li><li>Interface Design</li></ul></article>
        <div class="practice-bridge home-reveal" aria-hidden="true"><span>Idea</span><i></i><b>+</b><i></i><span>Interface</span></div>
        <article class="discipline discipline--development home-reveal" aria-labelledby="development-title"><div class="discipline-heading"><p class="discipline-index">02 / Working systems</p><h2 id="development-title">Development</h2></div><ul><li>Front-End</li><li>Responsive Systems</li><li>CMS / WordPress</li><li>PHP</li></ul></article>
      </div>
    </div>
  </section>

  <section class="about-teaser section rule"><div class="shell teaser-grid"><p class="eyebrow home-reveal">About Samuel</p><div><p class="teaser-copy home-reveal home-reveal--mask">A designer who understands how things are built. A developer who cares how they communicate.</p><p class="lede home-reveal">Based in Accra, I combine visual design and technical implementation across websites, publishing platforms and professional communications.</p><a class="link-arrow home-reveal" href="/about/">More about my practice</a></div></div></section>

  <section class="closing section"><div class="shell"><p class="eyebrow home-reveal">Start a conversation</p><a href="/contact/" class="closing-link home-reveal home-reveal--mask"><span>Have a project<br />in mind?</span><span class="closing-arrow" aria-hidden="true"><span>&nearr;</span></span></a></div></section>

  <script>
    const home = document.body;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealTargets = [...document.querySelectorAll<HTMLElement>('.home-reveal, .projects .project-card')];
    const hero = document.querySelector<HTMLElement>('.hero');

    if (hero && !reduceMotion && window.matchMedia('(pointer: fine)').matches) {
      hero.addEventListener('pointermove', (event) => {
        const bounds = hero.getBoundingClientRect();
        hero.style.setProperty('--hero-x', String((event.clientX - bounds.left) / bounds.width - .5));
        hero.style.setProperty('--hero-y', String((event.clientY - bounds.top) / bounds.height - .5));
      });
      hero.addEventListener('pointerleave', () => {
        hero.style.setProperty('--hero-x', '0');
        hero.style.setProperty('--hero-y', '0');
      });
    }

    if (!reduceMotion && 'IntersectionObserver' in window) {
      home.classList.add('home-motion-ready');
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting && entry.boundingClientRect.top >= 0) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });

      revealTargets.forEach((target, index) => {
        target.style.setProperty('--reveal-order', String(index % 3));
        revealObserver.observe(target);
      });
    } else {
      revealTargets.forEach((target) => target.classList.add('is-visible'));
    }
  </script>
</BaseLayout>
<style>
:global(body.homepage-experiment){--paper:#f6f0e5;--paper-deep:#e8ddce;--line:#c9bfaf;--ease-editorial:cubic-bezier(.22,.72,.18,1);--motion-fast:200ms;--motion-interaction:340ms;--motion-reveal:620ms;background:var(--paper)}
.hero{--hero-x:0;--hero-y:0;min-height:calc(100vh - 6rem);min-height:calc(100svh - 6rem);display:grid;grid-template-rows:auto 1fr auto;gap:clamp(2rem,4vh,3.5rem);padding-block:clamp(2rem,4vh,3.5rem) clamp(2.5rem,4vh,3.5rem);overflow:clip}.hero-kicker{display:flex;justify-content:space-between;gap:2rem}.index{margin:0;color:var(--muted);font-size:.68rem;letter-spacing:.08em;text-transform:uppercase}.hero-stage{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(22rem,.9fr);gap:clamp(2rem,5vw,6rem);align-items:center}.hero h1{position:relative;z-index:2;display:flex;min-width:0;flex-direction:column;width:calc(100% + clamp(2rem,6vw,7rem));margin:0;font-size:clamp(4.8rem,8.4vw,8.7rem);line-height:.76;transform:translate(calc(var(--hero-x) * -5px),calc(var(--hero-y) * -4px));transition:transform 500ms var(--ease-editorial)}.hero-line{display:block;white-space:nowrap}.hero-line--developer{margin-left:.48em}.hero-line--graphic{margin-top:.2em;margin-left:.85em;font-size:.56em;line-height:.9;letter-spacing:-.05em}.hero h1 em{display:inline-block;margin-right:.12em;color:var(--accent);font-size:1em;font-weight:400;line-height:1;transform:rotate(-7deg)}.hero-work-window{position:relative;display:block;aspect-ratio:1.08/1;overflow:hidden;border:1px solid #34332f;background:var(--ink);color:var(--paper);isolation:isolate;transform:translate(calc(var(--hero-x) * 10px),calc(var(--hero-y) * 8px));transition:transform 600ms var(--ease-editorial)}.hero-work-window::before{content:"";position:absolute;inset:0;z-index:4;border:.7rem solid var(--ink);pointer-events:none}.hero-work-window::after{content:"";position:absolute;top:0;right:24%;z-index:5;width:1px;height:100%;background:rgb(246 240 229/.24);pointer-events:none}.hero-window-meta{position:absolute;top:1.3rem;right:1.3rem;left:1.3rem;z-index:6;display:flex;justify-content:space-between;color:#c9c4ba;font-size:.58rem;font-weight:700;letter-spacing:.13em;text-transform:uppercase}.hero-interface{position:absolute;top:16%;right:11%;left:9%;z-index:1;display:block;box-shadow:0 1.5rem 4rem rgb(0 0 0/.38);transform:translate(calc(var(--hero-x) * -8px),calc(var(--hero-y) * -7px)) rotate(-1.5deg);transition:transform 650ms var(--ease-editorial)}.hero-interface :global(img){display:block;width:100%;height:auto;filter:saturate(.82) contrast(1.03)}.hero-publication{position:absolute;right:7%;bottom:7%;z-index:3;display:block;width:25%;box-shadow:0 1.2rem 2.5rem rgb(0 0 0/.48);transform:translate(calc(var(--hero-x) * 15px),calc(var(--hero-y) * 12px)) rotate(3.5deg);transition:transform 650ms var(--ease-editorial)}.hero-publication :global(img){display:block;width:100%;height:auto}.hero-window-caption{position:absolute;bottom:1.3rem;left:1.3rem;z-index:6;color:#d2cdc3;font-size:.6rem;line-height:1.45;letter-spacing:.1em;text-transform:uppercase}.hero-window-arrow{position:absolute;right:1.25rem;bottom:1.25rem;z-index:7;display:grid;width:3.25rem;aspect-ratio:1;place-items:center;border:1px solid rgb(246 240 229/.55);border-radius:50%;font-size:1rem;transition:background var(--motion-interaction) var(--ease-editorial),border-color var(--motion-interaction) var(--ease-editorial),transform var(--motion-interaction) var(--ease-editorial)}.hero-work-window:hover .hero-window-arrow,.hero-work-window:focus-visible .hero-window-arrow{border-color:var(--accent);background:var(--accent);transform:translate(.12rem,-.12rem)}.hero-work-window:focus-visible{outline-offset:.3rem}.hero-bottom{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:2rem}.hero-bottom>p{max-width:34rem;margin:0;font-size:clamp(1.15rem,2vw,1.65rem);line-height:1.35;letter-spacing:-.02em}.hero-actions{justify-self:end;display:flex;gap:2rem}.hero-link{display:inline-flex;align-items:center;justify-content:space-between;gap:1.5rem;padding-block:.65rem;border-bottom:1px solid var(--ink);font-size:.72rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase}.hero-link span{transition:transform var(--motion-fast) var(--ease-editorial)}.hero-link:hover span,.hero-link:focus-visible span{transform:translate(.18rem,-.18rem)}.hero-link:first-child:hover span,.hero-link:first-child:focus-visible span{transform:translateY(.18rem)}
.hero-kicker{animation:hero-detail-in 420ms 20ms both var(--ease-editorial)}.hero-line{animation:hero-title-in 650ms 80ms both var(--ease-editorial)}.hero-line--developer{animation-delay:140ms}.hero-line--graphic{animation-delay:210ms}.hero-work-window{animation:hero-window-in 720ms 150ms both var(--ease-editorial)}.hero h1 em{animation:hero-mark-in 480ms 300ms both var(--ease-editorial)}.hero-bottom{animation:hero-detail-in 500ms 380ms both var(--ease-editorial)}@keyframes hero-title-in{from{opacity:0;clip-path:inset(0 0 100% 0);transform:translateY(.18em)}to{opacity:1;clip-path:inset(0);transform:none}}@keyframes hero-window-in{from{opacity:0;clip-path:inset(100% 0 0 0)}to{opacity:1;clip-path:inset(0)}}@keyframes hero-mark-in{from{opacity:0;transform:translateY(.2em) rotate(-14deg)}to{opacity:1;transform:rotate(-7deg)}}@keyframes hero-detail-in{from{opacity:0;transform:translateY(.7rem)}}
.intro{position:relative;padding-block:clamp(3.5rem,6vw,6rem);background:var(--ink);color:var(--paper)}.intro-grid{display:grid;grid-template-columns:1fr 2.2fr .8fr;gap:4rem;align-items:start}.intro-copy{margin:-.15em 0 0;max-width:50rem;font-family:var(--font-display);font-size:clamp(2.4rem,5vw,5.4rem);line-height:.95;letter-spacing:-.05em}.intro-note{display:grid;gap:.65rem;border-top:1px solid #504f4a;padding-top:.9rem}.intro-note span{color:#aaa79f;font-size:.62rem;letter-spacing:.1em;text-transform:uppercase}.intro-note p{margin:1.5rem 0 0;color:#aaa79f;font-size:.78rem}
.work-section{position:relative;padding-bottom:clamp(4.5rem,6vw,6rem)}.work-heading{position:relative;display:grid;grid-template-columns:1fr 2.2fr .8fr;gap:4rem;align-items:end;margin-bottom:clamp(4rem,7vw,7rem);padding-top:2.1rem}.work-heading::before{content:"";position:absolute;top:0;left:0;width:min(18rem,28vw);height:2px;background:var(--accent);transform-origin:left}.work-heading h2{font-size:clamp(3rem,7vw,7.5rem)}.work-heading .link-arrow{justify-self:end}.projects{display:grid;grid-template-columns:repeat(12,1fr);gap:clamp(5rem,11vw,11rem) clamp(1rem,2vw,2rem)}.projects :global(.project-card:nth-child(1)){grid-column:1/10}.projects :global(.project-card:nth-child(2)){grid-column:5/13}.projects :global(.project-card:nth-child(3)){grid-column:2/13}.projects :global(.number){transition:color var(--motion-interaction) var(--ease-editorial),transform var(--motion-interaction) var(--ease-editorial)}.projects :global(.project-card:hover .number),.projects :global(.project-card:focus-within .number){color:var(--ink);transform:translateY(-.06em)}
.capabilities{position:relative;margin:0;overflow:visible;border-top:1px solid var(--ink);background:var(--paper);color:var(--ink)}.capabilities-intro{display:grid;grid-template-columns:1fr 2.35fr;gap:4rem;align-items:start;margin-bottom:clamp(5rem,9vw,9rem)}.capabilities-thesis{grid-column:2;max-width:64rem;margin:0;padding-top:.08em;font-family:var(--font-display);font-size:clamp(3.3rem,6.5vw,7rem);line-height:.94;letter-spacing:-.055em}.practice-stack{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:clamp(1rem,2vw,2rem)}.discipline{min-width:0}.discipline--design{grid-column:1/9}.discipline--development{grid-column:5/13}.discipline-heading{display:grid;grid-template-columns:1fr 4fr;align-items:end;padding-top:1.25rem;border-top:1px solid var(--ink)}.discipline-index{align-self:start;margin:.45rem 0 0;color:var(--muted);font-size:.64rem;letter-spacing:.12em;text-transform:uppercase}.discipline h2{margin:0;font-family:var(--font-display);font-size:clamp(5rem,10vw,10.5rem);font-weight:400;line-height:.8;letter-spacing:-.07em;transition:color var(--motion-interaction) var(--ease-editorial),transform var(--motion-interaction) var(--ease-editorial)}.discipline--development h2{font-size:clamp(4.7rem,8.2vw,8.8rem)}.discipline:hover h2{color:var(--accent);transform:translateX(.035em)}.discipline ul{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;margin:clamp(2rem,4vw,4rem) 0 0;padding:0;border-block:1px solid var(--line);list-style:none}.discipline li{padding:1rem .8rem 1rem 0;border-right:1px solid var(--line);font-size:.66rem;letter-spacing:.09em;text-transform:uppercase}.discipline li:not(:first-child){padding-left:.8rem}.discipline li:last-child{border-right:0}.practice-bridge{grid-column:3/11;display:grid;grid-template-columns:auto 1fr auto 1fr auto;gap:1rem;align-items:center;margin-block:clamp(3.5rem,7vw,7rem);color:var(--muted);font-size:.62rem;letter-spacing:.14em;text-transform:uppercase}.practice-bridge i{height:1px;background:var(--line)}.practice-bridge b{color:var(--accent);font-family:var(--font-display);font-size:2.4rem;font-weight:400;line-height:1}
.teaser-grid{display:grid;grid-template-columns:1fr 3fr;gap:4rem}.teaser-copy{margin:-.2em 0 2rem;max-width:65rem;font-family:var(--font-display);font-size:clamp(2.5rem,5.5vw,6rem);line-height:1;letter-spacing:-.05em}.teaser-grid .link-arrow{margin-top:2.5rem}.closing{position:relative;border-top:.4rem solid var(--accent);background:var(--ink);color:var(--paper)}.closing-link{position:relative;display:flex;justify-content:space-between;align-items:end;margin-top:3rem;font-family:var(--font-display);font-size:clamp(4rem,10vw,10rem);line-height:.86;letter-spacing:-.06em}.closing-link::after{content:"";position:absolute;right:0;bottom:-1.2rem;left:0;height:1px;background:var(--accent);transform:scaleX(0);transform-origin:left;transition:transform var(--motion-interaction) var(--ease-editorial)}.closing-arrow{flex:0 0 auto;display:grid;width:clamp(4rem,7vw,7rem);aspect-ratio:1;place-items:center;border:1px solid rgb(246 240 229/.55);border-radius:50%;overflow:hidden;color:var(--paper);font-family:var(--font-sans);font-size:clamp(1.5rem,2.5vw,2.6rem);font-weight:400;letter-spacing:0;line-height:1;transition:background var(--motion-interaction) var(--ease-editorial),border-color var(--motion-interaction) var(--ease-editorial)}.closing-arrow>span{transition:transform var(--motion-interaction) var(--ease-editorial)}.closing-link:hover::after,.closing-link:focus-visible::after{transform:scaleX(1)}.closing-link:hover .closing-arrow,.closing-link:focus-visible .closing-arrow{border-color:var(--accent);background:var(--accent)}.closing-link:hover .closing-arrow>span,.closing-link:focus-visible .closing-arrow>span{transform:translate(.18em,-.18em)}.closing-link:focus-visible{outline-color:var(--paper)}
:global(body.homepage-experiment.home-motion-ready) .home-reveal,:global(body.homepage-experiment.home-motion-ready) .projects :global(.project-card){opacity:0;transform:translateY(.9rem);transition:opacity var(--motion-reveal) var(--ease-editorial),transform var(--motion-reveal) var(--ease-editorial);transition-delay:calc(var(--reveal-order,0) * 55ms)}:global(body.homepage-experiment.home-motion-ready) .home-reveal--mask{clip-path:inset(0 0 14% 0);transition:opacity var(--motion-reveal) var(--ease-editorial),transform var(--motion-reveal) var(--ease-editorial),clip-path var(--motion-reveal) var(--ease-editorial)}:global(body.homepage-experiment.home-motion-ready) .home-reveal.is-visible,:global(body.homepage-experiment.home-motion-ready) .projects :global(.project-card.is-visible){opacity:1;transform:none;clip-path:inset(0)}
@media(hover:hover) and (pointer:fine) and (min-width:651px){.projects :global(.project-card:hover .preview-asset img),.projects :global(.project-card:focus-within .preview-asset img){scale:1}.projects :global(.project-card:hover .ita-desktop img),.projects :global(.project-card:focus-within .ita-desktop img){transform:translate(3px,-2px)}.projects :global(.project-card:hover .ita-mobile img),.projects :global(.project-card:focus-within .ita-mobile img){transform:translate(-5px,-6px)}.projects :global(.project-card:hover .evoke-desktop img),.projects :global(.project-card:focus-within .evoke-desktop img){transform:translate(-3px,2px)}.projects :global(.project-card:hover .evoke-mobile img),.projects :global(.project-card:focus-within .evoke-mobile img){transform:translate(5px,-5px)}.projects :global(.project-card:hover .visual-cover img),.projects :global(.project-card:focus-within .visual-cover img){transform:translate(-4px,-3px)}.projects :global(.project-card:hover .visual-publication img),.projects :global(.project-card:focus-within .visual-publication img){transform:translateY(-2px)}.projects :global(.project-card:hover .visual-campaign img),.projects :global(.project-card:focus-within .visual-campaign img){transform:translate(4px,-4px)}}
@media(max-width:900px){.hero{min-height:auto}.hero-stage{grid-template-columns:1fr}.hero h1{width:100%}.hero-work-window{justify-self:end;width:min(72%,34rem);margin-top:-4rem}.hero-bottom,.intro-grid,.work-heading,.teaser-grid{grid-template-columns:1fr;gap:2.5rem}.hero-actions{justify-self:start}.intro-note{max-width:22rem}.work-heading .link-arrow{justify-self:start}.capabilities-intro{grid-template-columns:1fr;gap:2.5rem}.capabilities-thesis{grid-column:1}.discipline--design,.discipline--development{grid-column:1/13}.discipline-heading{grid-template-columns:1fr 5fr}.practice-bridge{grid-column:1/13}}
@media(min-width:901px){.capabilities-heading .eyebrow{align-self:start;margin-top:.7rem}}
@media(max-width:650px){.hero{grid-template-rows:auto auto auto;gap:clamp(2.5rem,9vw,3.5rem);padding-block:1.5rem 3.25rem}.hero-kicker{align-items:start}.hero-stage{gap:2.4rem}.hero h1{font-size:clamp(4rem,20vw,5.6rem);line-height:.76}.hero-line{white-space:nowrap}.hero-line--developer{margin-left:.16em}.hero-line--graphic{margin-top:.28em;margin-left:.25em;font-size:.5em;line-height:.95}.hero h1 em{margin-right:.08em;transform:rotate(-7deg)}.hero-work-window{width:94%;margin-top:0;aspect-ratio:1.12/1}.hero-window-meta{top:1rem;right:1rem;left:1rem}.hero-window-caption{bottom:1rem;left:1rem}.hero-window-arrow{right:1rem;bottom:1rem;width:2.8rem}.hero-bottom{align-self:auto;gap:1.5rem}.hero-actions{width:100%;display:grid;grid-template-columns:1fr 1fr;gap:1rem}.hero-link{gap:.75rem}.intro{padding-block:3.5rem}.intro-copy{font-size:clamp(2.6rem,13vw,4rem)}.projects{grid-template-columns:minmax(0,1fr);row-gap:5.5rem;column-gap:0}.projects :global(.project-card){grid-column:1!important}.work-section{padding-bottom:4rem}.capabilities-intro{margin-bottom:4.5rem}.capabilities-thesis{font-size:clamp(3rem,13.5vw,4.2rem)}.discipline-heading{grid-template-columns:1fr}.discipline-index{margin:0 0 2rem}.discipline h2{font-size:clamp(4.8rem,24vw,7rem)}.discipline--development h2{font-size:clamp(3.5rem,15.5vw,5.2rem)}.discipline ul{grid-template-columns:1fr 1fr;margin-top:2.5rem}.discipline li:nth-child(2){border-right:0}.discipline li:nth-child(-n+2){border-bottom:1px solid var(--line)}.practice-bridge{grid-template-columns:auto 1fr auto 1fr auto;margin-block:4rem;gap:.65rem}.closing-link{align-items:start}}
@media(max-width:500px){.hero-actions{grid-template-columns:1fr}.discipline ul{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){.hero-kicker,.hero-line,.hero-work-window,.hero h1 em,.hero-bottom{animation:none}.hero h1,.hero-work-window,.hero-interface,.hero-publication{transform:none!important;transition:none!important}.home-reveal,.projects :global(.project-card){opacity:1!important;transform:none!important;clip-path:none!important}.discipline h3::after,.closing-link::after{transition:none}}
</style>
