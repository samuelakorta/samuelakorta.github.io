---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---
<BaseLayout>
  <section class="hero shell reveal"><div class="hero-kicker"><p class="eyebrow">Samuel Akorta / Accra, Ghana</p><p class="index">Portfolio — 2026</p></div><h1 class="display"><span>Web Developer</span><em>&amp;</em><span>Graphic Designer</span></h1><div class="hero-bottom"><p>I design visual experiences and build the websites that bring them to life.</p><div class="hero-actions"><a class="button" href="#selected-work">View selected work</a><a class="button button--ghost" href="/contact/">Let’s work together</a></div></div></section>

  <section class="intro rule"><div class="shell intro-grid"><p class="eyebrow">Design + implementation</p><p class="intro-copy">I work across web design, development and visual communication—moving from a clear idea and interface through to the functional experience.</p><div class="intro-note"><span>01</span><p>Visual taste backed by production experience.</p></div></div></section>

  <section class="section shell" id="selected-work"><div class="work-heading"><p class="eyebrow">Selected work / 01—04</p><h2 class="display">Work that lives<br />in the real world.</h2><a class="link-arrow" href="/work/">View all projects</a></div><div class="projects">{projects.map((project) => <ProjectCard project={project} />)}</div></section>

  <section class="capabilities section rule"><div class="shell capabilities-grid"><div><p class="eyebrow">Capabilities</p><h2 class="display">One practice,<br />two disciplines.</h2></div><ol><li><span>01</span> Web Design</li><li><span>02</span> Front-End Development</li><li><span>03</span> PHP / Custom CMS</li><li><span>04</span> WordPress</li><li><span>05</span> UI Implementation</li><li><span>06</span> Graphic Design</li><li><span>07</span> Brochures &amp; Corporate Collateral</li></ol></div></section>

  <section class="about-teaser section rule"><div class="shell teaser-grid"><p class="eyebrow">About Samuel</p><div><p class="teaser-copy">A designer who understands how things are built. A developer who cares how they communicate.</p><p class="lede">Based in Accra, I combine visual design and technical implementation across websites, publishing platforms and professional communications.</p><a class="link-arrow" href="/about/">More about my practice</a></div></div></section>

  <section class="closing section"><div class="shell"><p class="eyebrow">Start a conversation</p><a href="/contact/" class="closing-link"><span>Have a project<br />in mind?</span><i>↗</i></a></div></section>
</BaseLayout>
<style>
.hero{min-height:calc(100vh - 6rem);min-height:calc(100svh - 6rem);display:grid;grid-template-rows:auto 1fr auto;padding-block:clamp(2rem,5vh,4.5rem) clamp(2.5rem,5vh,4rem)}.hero-kicker{display:flex;justify-content:space-between;gap:2rem}.index{margin:0;color:var(--muted);font-size:.68rem;letter-spacing:.08em;text-transform:uppercase}.hero h1{align-self:center;display:flex;flex-direction:column;font-size:clamp(4.25rem,10.7vw,10.7rem)}.hero h1 span:last-child{align-self:flex-end}.hero h1 em{align-self:center;margin-block:-.25em;color:var(--accent);font-size:.52em;font-weight:400}.hero-bottom{display:grid;grid-template-columns:minmax(18rem,35rem) auto;align-items:end;justify-content:space-between;gap:2rem}.hero-bottom>p{margin:0;font-size:clamp(1.15rem,2vw,1.65rem);line-height:1.35;letter-spacing:-.02em}.hero-actions{display:flex;gap:.7rem}.intro{padding-block:clamp(4rem,8vw,8rem)}.intro-grid{display:grid;grid-template-columns:1fr 2.2fr .8fr;gap:4rem;align-items:start}.intro-copy{margin:-.15em 0 0;max-width:50rem;font-family:var(--font-display);font-size:clamp(2rem,4vw,4.3rem);line-height:1.04;letter-spacing:-.045em}.intro-note{border-top:1px solid var(--line);padding-top:.9rem}.intro-note span{color:var(--accent);font-family:var(--font-display)}.intro-note p{margin:2rem 0 0;color:var(--muted);font-size:.78rem}.work-heading{display:grid;grid-template-columns:1fr 2.2fr .8fr;gap:4rem;align-items:end;margin-bottom:clamp(3rem,6vw,6rem)}.work-heading h2{font-size:clamp(3rem,7vw,7.5rem)}.work-heading .link-arrow{justify-self:end}.projects{display:grid;grid-template-columns:repeat(12,1fr);gap:clamp(4rem,9vw,9rem) clamp(1rem,2vw,2rem)}.projects :global(.project-card:nth-child(1)){grid-column:1/10}.projects :global(.project-card:nth-child(2)){grid-column:5/13}.projects :global(.project-card:nth-child(3)){grid-column:1/9}.projects :global(.project-card:nth-child(4)){grid-column:4/13}.capabilities-grid{display:grid;grid-template-columns:1fr 1.4fr;gap:8vw}.capabilities h2{margin-top:2rem;font-size:clamp(3rem,6vw,6.5rem)}.capabilities ol{margin:0;padding:0;list-style:none;border-top:1px solid var(--ink)}.capabilities li{display:grid;grid-template-columns:3rem 1fr;padding-block:1.15rem;border-bottom:1px solid var(--line);font-family:var(--font-display);font-size:clamp(1.3rem,2vw,2rem)}.capabilities li span{padding-top:.35rem;color:var(--muted);font-family:var(--font-sans);font-size:.62rem;letter-spacing:.08em}.teaser-grid{display:grid;grid-template-columns:1fr 3fr;gap:4rem}.teaser-copy{margin:-.2em 0 2rem;max-width:65rem;font-family:var(--font-display);font-size:clamp(2.5rem,5.5vw,6rem);line-height:1;letter-spacing:-.05em}.teaser-grid .link-arrow{margin-top:2.5rem}.closing{background:var(--ink);color:var(--paper)}.closing-link{display:flex;justify-content:space-between;align-items:end;margin-top:3rem;font-family:var(--font-display);font-size:clamp(4rem,10vw,10rem);line-height:.86;letter-spacing:-.06em}.closing-link i{font-size:.35em;font-style:normal;transition:transform var(--transition)}.closing-link:hover i{transform:translate(.25em,-.25em)}
@media(max-width:900px){.hero{min-height:44rem}.hero-bottom,.intro-grid,.work-heading,.capabilities-grid,.teaser-grid{grid-template-columns:1fr;gap:2.5rem}.hero-actions{justify-self:start}.intro-note{max-width:20rem}.work-heading .link-arrow{justify-self:start}}@media(max-width:650px){.hero{min-height:calc(100svh - 5rem)}.hero h1{font-size:clamp(3.55rem,18vw,6.4rem)}.hero h1 span:last-child{align-self:flex-start}.hero h1 em{align-self:flex-end;margin-right:8%}.hero-bottom{gap:1.5rem}.hero-actions{width:100%;flex-direction:column}.hero-actions a{width:100%}.projects{display:grid;gap:4.5rem}.projects :global(.project-card){grid-column:1/-1!important}.closing-link{align-items:start}}
</style>
