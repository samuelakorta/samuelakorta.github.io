---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
---
<BaseLayout bodyClass="about-page" title="About — Samuel Akorta" description="About Samuel Akorta, a Web Developer and Graphic Designer based in Accra, Ghana.">
  <PageIntro eyebrow="About / Profile" title="Designing the idea. Building the outcome." intro="Samuel Akorta is a Web Developer & Graphic Designer based in Accra, Ghana." />
  <section class="profile section rule"><div class="shell profile-grid"><p class="eyebrow">Practice</p><div class="profile-copy"><p>My work combines visual design and technical implementation, allowing me to move from concept and interface design through to functional digital experiences.</p><p>I work across websites, publishing platforms, WordPress systems and visual communication. Professional experience includes digital work for Evoke Impact and ongoing technical platform work involving ITA Africa.</p></div><aside><span>Based in</span><strong>Accra, Ghana</strong><span>Focus</span><strong>Web + Visual Design</strong></aside></div></section>

  <section class="dual-practice section" aria-labelledby="dual-practice-title"><div class="shell practice-grid"><p class="eyebrow">One practice / Two disciplines</p><div class="practice-pair"><article><span>01 / Visual direction</span><h2 id="dual-practice-title" class="display">Design</h2><p>Editorial design · Campaigns · Graphic systems · Interface design</p></article><article><span>02 / Working systems</span><h2 class="display">Development</h2><p>Front-end · CMS · Responsive systems · Web implementation</p></article></div></div></section>

  <section class="experience section rule"><div class="shell"><div class="section-title"><p class="eyebrow">Selected experience</p><h2 class="display">Experience</h2></div><div class="experience-list"><article><span>01</span><h3>Evoke Impact</h3><p>Digital Creative Manager</p><small>Website design and implementation, summit websites, campaigns, brochures and digital creative production.</small></article><article><span>02</span><h3>ITA Africa</h3><p>Web Development / Digital Platform Management</p><small>Responsive front-end work, PHP CMS customisation, platform maintenance and ongoing development.</small></article></div><div class="experience-utility"><a href="/resume/Samuel-Akorta-Resume.pdf" target="_blank" rel="noopener noreferrer">Download Résumé <span aria-hidden="true">↓</span></a></div></div></section>

  <section class="statement"><div class="shell"><p class="display">The strongest work happens when visual decisions survive implementation.</p><a class="statement-link" href="/contact/"><span>Start a conversation</span><i aria-hidden="true">↗</i></a></div></section>
</BaseLayout>
<style>
:global(body.about-page){--paper:#f6f0e5;--paper-deep:#e8ddce;--line:#c9bfaf;background:var(--paper)}:global(.about-page .page-intro){position:relative}:global(.about-page .page-intro)::before{content:"";position:absolute;top:clamp(3rem,6vw,6rem);left:var(--gutter);width:clamp(5rem,12vw,11rem);height:2px;background:var(--accent)}:global(.about-page .page-intro h1){line-height:.88}
.profile-grid{display:grid;grid-template-columns:1fr 2fr 1fr;gap:5vw}.profile-copy p{margin:0 0 2rem;font-family:var(--font-display);font-size:clamp(1.8rem,3.5vw,3.6rem);line-height:1.08;letter-spacing:-.04em}.profile-copy p:last-child{margin-bottom:0;color:var(--muted);font-family:var(--font-sans);font-size:1.05rem;line-height:1.6;letter-spacing:0}.profile aside{display:grid;grid-template-columns:1fr;align-content:start;padding-top:1rem;border-top:1px solid var(--ink)}.profile aside span{margin:0 0 .4rem;color:var(--muted);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase}.profile aside strong{margin-bottom:2rem;font-family:var(--font-display);font-size:1.3rem;font-weight:400}.dual-practice{overflow:hidden;background:var(--ink);color:var(--paper)}.practice-grid{display:grid;grid-template-columns:1fr 3fr;gap:5vw}.practice-pair{display:grid;gap:clamp(3rem,6vw,6rem)}.practice-pair article{display:grid;grid-template-columns:1fr 2.4fr;align-items:end;border-top:1px solid #504f4a;padding-top:1rem}.practice-pair article:last-child{margin-left:12%}.practice-pair span{color:#aaa79f;font-size:.62rem;letter-spacing:.1em;text-transform:uppercase}.practice-pair h2{grid-column:1/-1;font-size:clamp(5rem,10vw,10rem);line-height:.82}.practice-pair article:last-child h2{text-align:right}.practice-pair p{grid-column:2;margin:1.5rem 0 0;color:#aaa79f;font-size:.72rem;line-height:1.6;letter-spacing:.08em;text-transform:uppercase}.section-title{display:grid;grid-template-columns:1fr 3fr;gap:3rem;align-items:end;margin-bottom:4rem}.section-title h2{font-size:clamp(4rem,9vw,9rem)}.experience-list{margin-left:25%;border-top:1px solid var(--ink)}.experience-list article{display:grid;grid-template-columns:3rem 1.2fr 1.2fr 1.4fr;gap:2rem;padding-block:2rem;border-bottom:1px solid var(--line)}.experience-list span{color:var(--accent);font-size:.68rem}.experience-list h3,.experience-list p{margin:0}.experience-list h3{font-family:var(--font-display);font-size:1.7rem;font-weight:400}.experience-list p{font-size:.85rem}.experience-list small{color:var(--muted);line-height:1.5}.statement{padding-block:var(--section-space);background:var(--paper-deep)}.statement .display{max-width:72rem;font-size:clamp(3rem,7vw,7.5rem)}.statement .button{margin-top:3rem}
@media(max-width:850px){.profile-grid,.practice-grid,.section-title{grid-template-columns:1fr;gap:2rem}.practice-pair article:last-child{margin-left:0}.experience-list{margin-left:0}.experience-list article{grid-template-columns:2rem 1fr}.experience-list article p,.experience-list article small{grid-column:2}}@media(max-width:550px){.profile-copy p{font-size:2rem}.practice-pair article{grid-template-columns:1fr}.practice-pair h2{font-size:clamp(3rem,15.5vw,5rem)}.practice-pair article:last-child h2{text-align:left}.practice-pair p{grid-column:1}.experience-list article{gap:1rem}}
.experience-list article{transition:padding-left var(--transition),color var(--transition)}.experience-list article:hover{padding-left:1rem}.statement{border-top:1px solid var(--ink)}.statement-link{display:flex;justify-content:space-between;align-items:center;max-width:72rem;margin-top:clamp(3rem,5vw,5rem);padding-block:1.25rem;border-block:1px solid var(--ink);font-size:.78rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.statement-link i{font-size:1.4rem;font-style:normal;transition:transform var(--transition)}.statement-link:hover i,.statement-link:focus-visible i{transform:translate(.25rem,-.25rem)}@media(max-width:550px){:global(.about-page .page-intro)::before{top:2.25rem}.experience-list article:hover{padding-left:0}}
.experience-utility{display:flex;justify-content:flex-end;margin:1.5rem 0 0 25%}.experience-utility a{display:inline-flex;gap:1rem;padding-bottom:.55rem;border-bottom:1px solid var(--ink);font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.experience-utility span{color:var(--accent);font-size:1rem;line-height:.7}@media(max-width:850px){.experience-utility{margin-left:0}}
</style>
