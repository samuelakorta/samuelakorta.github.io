---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
---
<BaseLayout title="About — Samuel Akorta" description="About Samuel Akorta, a Web Developer and Graphic Designer based in Accra, Ghana.">
  <PageIntro eyebrow="About / Profile" title="Designing the idea. Building the outcome." intro="Samuel Akorta is a Web Developer & Graphic Designer based in Accra, Ghana." />
  <section class="profile section rule"><div class="shell profile-grid"><p class="eyebrow">Practice</p><div class="profile-copy"><p>My work combines visual design and technical implementation, allowing me to move from concept and interface design through to functional digital experiences.</p><p>I work across websites, publishing platforms, WordPress systems and visual communication. Professional experience includes digital work for Evoke Impact and ongoing technical platform work involving ITA Africa.</p></div><aside><span>Based in</span><strong>Accra, Ghana</strong><span>Focus</span><strong>Web + Visual Design</strong></aside></div></section>

  <section class="experience section rule"><div class="shell"><div class="section-title"><p class="eyebrow">Selected experience</p><h2 class="display">Experience</h2></div><div class="experience-list"><article><span>01</span><h3>Evoke Impact</h3><p>Digital Creative Manager</p><small>Website design and implementation, summit websites, campaigns, brochures and digital creative production.</small></article><article><span>02</span><h3>ITA Africa</h3><p>Web Development / Digital Platform Management</p><small>Responsive front-end work, PHP CMS customisation, platform maintenance and ongoing development.</small></article></div></div></section>

  <section class="education section rule"><div class="shell education-grid"><p class="eyebrow">Education</p><h2>BSc Electrical &amp;<br />Electronic Engineering</h2><p>University and dates to be added once confirmed.</p></div></section>

  <section class="statement"><div class="shell"><p class="display">The strongest work happens when visual decisions survive implementation.</p><a class="button" href="/contact/">Start a conversation</a></div></section>
</BaseLayout>
<style>
.profile-grid{display:grid;grid-template-columns:1fr 2fr 1fr;gap:5vw}.profile-copy p{margin:0 0 2rem;font-family:var(--font-display);font-size:clamp(1.8rem,3.5vw,3.6rem);line-height:1.08;letter-spacing:-.04em}.profile-copy p:last-child{margin-bottom:0;color:var(--muted);font-family:var(--font-sans);font-size:1.05rem;line-height:1.6;letter-spacing:0}.profile aside{display:grid;grid-template-columns:1fr;align-content:start;padding-top:1rem;border-top:1px solid var(--ink)}.profile aside span{margin:0 0 .4rem;color:var(--muted);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase}.profile aside strong{margin-bottom:2rem;font-family:var(--font-display);font-size:1.3rem;font-weight:400}.section-title{display:grid;grid-template-columns:1fr 3fr;gap:3rem;align-items:end;margin-bottom:4rem}.section-title h2{font-size:clamp(4rem,9vw,9rem)}.experience-list{margin-left:25%;border-top:1px solid var(--ink)}.experience-list article{display:grid;grid-template-columns:3rem 1.2fr 1.2fr 1.4fr;gap:2rem;padding-block:2rem;border-bottom:1px solid var(--line)}.experience-list span{color:var(--accent);font-size:.68rem}.experience-list h3,.experience-list p{margin:0}.experience-list h3{font-family:var(--font-display);font-size:1.7rem;font-weight:400}.experience-list p{font-size:.85rem}.experience-list small{color:var(--muted);line-height:1.5}.education-grid{display:grid;grid-template-columns:1fr 2fr 1fr;gap:5vw;align-items:start}.education h2{margin:0;font-family:var(--font-display);font-size:clamp(2.5rem,5vw,5rem);font-weight:400;line-height:1;letter-spacing:-.045em}.education-grid>p:last-child{margin:0;color:var(--muted);font-size:.8rem}.statement{padding-block:var(--section-space);background:var(--paper-deep)}.statement .display{max-width:72rem;font-size:clamp(3rem,7vw,7.5rem)}.statement .button{margin-top:3rem}
@media(max-width:850px){.profile-grid,.section-title,.education-grid{grid-template-columns:1fr;gap:2rem}.experience-list{margin-left:0}.experience-list article{grid-template-columns:2rem 1fr}.experience-list article p,.experience-list article small{grid-column:2}}@media(max-width:550px){.profile-copy p{font-size:2rem}.experience-list article{gap:1rem}.education h2 br{display:none}}
</style>

