---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — Samuel Akorta" description="Contact Samuel Akorta for web development, web design and graphic design projects.">
  <section class="contact-hero shell reveal"><p class="eyebrow">Contact / Accra, Ghana</p><h1 class="display">Let’s build something worth showing.</h1><p class="availability"><span></span> Available for selected freelance projects and creative roles.</p></section>
  <section class="contact-options rule"><div class="shell contact-grid"><p class="eyebrow">Start here</p><div class="links"><div class="contact-placeholder"><small>Email</small><strong>Public email coming soon</strong><p>TODO: connect Samuel’s final public contact email.</p></div><a href="https://www.linkedin.com/in/samuel-akorta-2b4552227/" target="_blank" rel="noreferrer"><small>LinkedIn</small><strong>Samuel Akorta</strong><i>↗</i></a><a href="https://github.com/samuelakorta" target="_blank" rel="noreferrer"><small>GitHub</small><strong>@samuelakorta</strong><i>↗</i></a></div></div></section>
  <section class="contact-details section rule"><div class="shell details-grid"><p class="eyebrow">Good fit</p><ul><li>Web design &amp; front-end builds</li><li>Custom CMS &amp; PHP platform work</li><li>WordPress design &amp; implementation</li><li>Brand, brochure &amp; campaign design</li><li>Digital designer / creative developer roles</li></ul><div class="resume"><p>Résumé</p><span>The final résumé file has not been supplied yet.</span><button class="button button--ghost" type="button" disabled aria-disabled="true">Download résumé — coming soon</button></div></div></section>
</BaseLayout>
<style>
.contact-hero{min-height:calc(78vh - 6rem);min-height:calc(78svh - 6rem);display:grid;grid-template-columns:1fr 3fr;gap:3rem;padding-block:clamp(4rem,9vw,9rem);align-content:space-between}.contact-hero h1{font-size:clamp(4rem,10vw,10rem);max-width:70rem}.availability{grid-column:2;display:flex;align-items:center;gap:.7rem;margin:0;color:var(--muted);font-size:.78rem;text-transform:uppercase;letter-spacing:.08em}.availability span{width:.5rem;height:.5rem;border-radius:50%;background:#56704e}.contact-options{padding-block:var(--section-space)}.contact-grid{display:grid;grid-template-columns:1fr 3fr;gap:3rem}.links{border-top:1px solid var(--ink)}.links>a,.contact-placeholder{display:grid;grid-template-columns:1fr 2fr auto;gap:2rem;align-items:center;padding-block:2rem;border-bottom:1px solid var(--line)}.links small{font-size:.65rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}.links strong{font-family:var(--font-display);font-size:clamp(1.8rem,4vw,4rem);font-weight:400;letter-spacing:-.04em}.links i{font-style:normal;font-size:1.4rem;transition:transform var(--transition)}.links>a:hover i{transform:translate(.25rem,-.25rem)}.contact-placeholder p{grid-column:2;margin:0;color:var(--muted);font-size:.75rem}.details-grid{display:grid;grid-template-columns:1fr 1.7fr 1.3fr;gap:5vw}.details-grid ul{margin:0;padding:0;list-style:none;border-top:1px solid var(--ink)}.details-grid li{padding-block:1rem;border-bottom:1px solid var(--line);font-family:var(--font-display);font-size:1.25rem}.resume{align-self:start;padding:1.5rem;background:var(--paper-deep)}.resume p{margin:0 0 2rem;font-family:var(--font-display);font-size:2rem}.resume span{display:block;margin-bottom:2rem;color:var(--muted);font-size:.8rem}.resume button{width:100%;opacity:.55;cursor:not-allowed}
@media(max-width:800px){.contact-hero,.contact-grid,.details-grid{grid-template-columns:1fr}.contact-hero h1,.availability{grid-column:1}.contact-hero{min-height:40rem}.links>a,.contact-placeholder{grid-template-columns:1fr auto}.links strong{grid-row:2}.contact-placeholder p{grid-column:1/-1}.details-grid{gap:3rem}}@media(max-width:500px){.contact-hero h1{font-size:clamp(3.5rem,18vw,6rem)}}
</style>

