---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout bodyClass="contact-page" title="Contact — Samuel Akorta" description="Contact Samuel Akorta for web development, web design and graphic design projects.">
  <section class="contact-hero shell reveal"><p class="eyebrow">Contact / Accra, Ghana</p><h1 class="display">Let’s build something worth showing.</h1><p class="availability"><span></span> Available for selected freelance projects and creative roles.</p></section>
  <section class="contact-options"><div class="shell contact-grid"><p class="eyebrow">Start here / Primary contact</p><div class="links"><a class="email-primary" href="mailto:samuelakorta5@gmail.com"><small>Email / Direct</small><strong><span>samuelakorta5</span><span>@gmail.com</span></strong><i>↗</i></a><a href="https://www.linkedin.com/in/samuel-akorta-2b4552227/" target="_blank" rel="noreferrer"><small>LinkedIn</small><strong>Samuel Akorta</strong><i>↗</i></a><a href="https://github.com/samuelakorta" target="_blank" rel="noreferrer"><small>GitHub</small><strong>@samuelakorta</strong><i>↗</i></a></div></div></section>
  <section class="contact-details section rule"><div class="shell details-grid"><p class="eyebrow">Good fit</p><ul><li>Web design &amp; front-end builds</li><li>Custom CMS &amp; PHP platform work</li><li>WordPress design &amp; implementation</li><li>Brand, brochure &amp; campaign design</li><li>Digital designer / creative developer roles</li></ul><aside class="project-note"><p class="eyebrow">A useful first message</p><strong>Share the project, timing and what already exists.</strong><span>That is enough to start a focused conversation.</span><a class="link-arrow" href="mailto:samuelakorta5@gmail.com">Write an email</a></aside></div></section>
</BaseLayout>
<style>
:global(body.contact-page){--paper:#f6f0e5;--paper-deep:#e8ddce;--line:#c9bfaf;background:var(--paper)}
.contact-hero{min-height:calc(78vh - 6rem);min-height:calc(78svh - 6rem);display:grid;grid-template-columns:1fr 3fr;gap:3rem;padding-block:clamp(4rem,9vw,9rem);align-content:space-between}.contact-hero h1{font-size:clamp(4rem,10vw,10rem);max-width:70rem}.availability{grid-column:2;display:flex;align-items:center;gap:.7rem;margin:0;color:var(--muted);font-size:.78rem;text-transform:uppercase;letter-spacing:.08em}.availability span{width:.5rem;height:.5rem;border-radius:50%;background:#56704e}.contact-options{padding-block:var(--section-space);background:var(--ink);color:var(--paper)}.contact-grid{display:grid;grid-template-columns:1fr 3fr;gap:3rem}.links{border-top:1px solid #504f4a}.links>a{display:grid;grid-template-columns:1fr 2fr auto;gap:2rem;align-items:center;padding-block:2rem;border-bottom:1px solid #504f4a}.links small{font-size:.65rem;text-transform:uppercase;letter-spacing:.1em;color:#aaa79f}.links strong{font-family:var(--font-display);font-size:clamp(1.8rem,3.2vw,3.4rem);font-weight:400;letter-spacing:-.04em}.links i{font-style:normal;font-size:1.4rem;transition:transform var(--transition)}.links>a:hover i,.links>a:focus-visible i{transform:translate(.25rem,-.25rem)}.links>a:focus-visible{outline-color:var(--paper)}.links>a.email-primary{grid-template-columns:1fr auto;padding-block:clamp(2.5rem,5vw,5rem)}.email-primary strong{grid-column:1/-1;font-size:clamp(3rem,7vw,7.8rem);line-height:.82;letter-spacing:-.055em}.email-primary strong span{display:block}.email-primary i{grid-column:2;grid-row:1}.details-grid{display:grid;grid-template-columns:1fr 1.7fr 1.3fr;gap:5vw}.details-grid ul{margin:0;padding:0;list-style:none;border-top:1px solid var(--ink)}.details-grid li{padding-block:1rem;border-bottom:1px solid var(--line);font-family:var(--font-display);font-size:1.25rem}.project-note{align-self:start;padding:1.5rem;background:var(--paper-deep)}.project-note strong{display:block;margin:2rem 0 1rem;font-family:var(--font-display);font-size:clamp(1.6rem,2.4vw,2.25rem);font-weight:400;line-height:1.05;letter-spacing:-.035em}.project-note>span{display:block;margin-bottom:2rem;color:var(--muted);font-size:.82rem}.project-note .link-arrow{font-size:.7rem}
@media(max-width:800px){.contact-hero,.contact-grid,.details-grid{grid-template-columns:1fr}.contact-hero h1,.availability{grid-column:1}.contact-hero{min-height:40rem}.links>a{grid-template-columns:1fr auto}.links strong{grid-row:2}.email-primary strong{font-size:clamp(2.5rem,11vw,5rem)}.details-grid{gap:3rem}}@media(max-width:500px){.contact-hero h1{font-size:clamp(3.5rem,18vw,6rem)}.email-primary strong{font-size:clamp(2.25rem,10vw,3rem)}}
.contact-hero{position:relative}.contact-hero::before{content:"";position:absolute;top:clamp(3rem,6vw,6rem);left:var(--gutter);width:clamp(5rem,12vw,11rem);height:2px;background:var(--accent)}.contact-options{border-top:.35rem solid var(--accent)}.links i{display:grid;width:3.4rem;aspect-ratio:1;place-items:center;border:1px solid #504f4a;border-radius:50%;font-family:var(--font-sans);font-size:1rem;transition:transform var(--transition),background var(--transition),border-color var(--transition)}.links>a:hover i,.links>a:focus-visible i{border-color:var(--accent);background:var(--accent);transform:translate(.15rem,-.15rem)}.project-note{padding:1.5rem 0;background:transparent;border-top:1px solid var(--ink)}
@media(max-width:500px){.contact-hero::before{top:2.25rem}.links i{width:3rem}}
</style>
