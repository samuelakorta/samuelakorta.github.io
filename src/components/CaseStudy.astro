---
import type { Project } from '../data/projects';
import ProjectPlaceholder from './ProjectPlaceholder.astro';
interface Props { project: Project; previous: Project; next: Project; }
const { project, previous, next } = Astro.props;
---
<article>
  <header class="case-hero shell reveal">
    <div class="case-index"><p class="eyebrow">Case study / {project.number}</p><a href="/work/">All work ↗</a></div>
    <h1 class="display">{project.title}</h1>
    <p class="subtitle">{project.subtitle}</p>
    <div class="case-meta"><dl><div><dt>Organization</dt><dd>{project.organization}</dd></div><div><dt>Role</dt><dd>{project.role}</dd></div><div><dt>Disciplines</dt><dd>{project.disciplines.join(', ')}</dd></div><div><dt>Technology</dt><dd>{project.technology}</dd></div><div><dt>Year</dt><dd>{project.year}</dd></div></dl></div>
  </header>

  <section class="shell hero-visual"><ProjectPlaceholder label={project.title} tone={project.tone} note={`TODO: replace with final ${project.title} hero artwork`} /></section>

  <section class="overview section"><div class="shell overview-grid"><p class="eyebrow">Project overview</p><p>{project.summary}</p></div></section>

  <div class="case-body shell">
    {project.sections.map((section, index) => (
      <section class="case-section">
        <p class="section-number">{String(index + 1).padStart(2, '0')}</p>
        <h2>{section.title}</h2>
        <p>{section.body}</p>
        {index === 1 && <div class="inline-visual"><ProjectPlaceholder label={`${project.title} / Detail`} tone={project.tone} note="TODO: replace with project screen or artwork" /></div>}
      </section>
    ))}
  </div>

  <section class="media-system section rule"><div class="shell"><div class="media-heading"><p class="eyebrow">Flexible media system</p><p>Structured for real project screens and artwork.</p></div><div class="media-pair"><ProjectPlaceholder label="Detail / 01" tone={project.tone} ratio="portrait" note="TODO: portrait asset" /><ProjectPlaceholder label="Detail / 02" tone={project.tone} ratio="square" note="TODO: landscape or detail asset" /></div></div></section>

  <nav class="project-nav rule" aria-label="Project navigation"><a href={`/work/${previous.slug}/`}><small>Previous project</small><span>← {previous.title}</span></a><a href={`/work/${next.slug}/`}><small>Next project</small><span>{next.title} →</span></a></nav>
</article>
<style>
.case-hero{padding-block:clamp(3.5rem,8vw,8rem);display:grid;grid-template-columns:1fr 3fr;gap:1rem 4rem}.case-index{display:flex;flex-direction:column;justify-content:space-between;padding-bottom:.8rem}.case-index a{color:var(--muted);font-size:.7rem;text-transform:uppercase;letter-spacing:.08em}.case-hero h1{font-size:clamp(4.5rem,12vw,12rem)}.subtitle{grid-column:2;margin:0;font-family:var(--font-display);font-size:clamp(1.7rem,3vw,3rem);letter-spacing:-.035em}.case-meta{grid-column:2;margin-top:4rem}.case-meta dl{margin:0;display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--ink)}.case-meta dl div{padding:1rem 1rem 0 0}.case-meta dt{margin-bottom:.5rem;color:var(--muted);font-size:.62rem;letter-spacing:.09em;text-transform:uppercase}.case-meta dd{margin:0;font-size:.78rem;line-height:1.4}.hero-visual :global(.placeholder){min-height:clamp(24rem,65vw,58rem)}.overview{background:var(--ink);color:var(--paper)}.overview-grid{display:grid;grid-template-columns:1fr 3fr;gap:4rem}.overview-grid>p:last-child{max-width:65rem;margin:-.2em 0 0;font-family:var(--font-display);font-size:clamp(2.3rem,5vw,5rem);line-height:1.02;letter-spacing:-.045em}.case-body{padding-block:var(--section-space)}.case-section{display:grid;grid-template-columns:1fr 2fr 2fr;gap:3rem;padding-block:3rem;border-top:1px solid var(--line)}.section-number{color:var(--accent);font-size:.72rem}.case-section h2{margin:0;font-family:var(--font-display);font-size:clamp(2rem,3vw,3.5rem);font-weight:400;line-height:1;letter-spacing:-.04em}.case-section>p:last-of-type{margin:0;max-width:36rem;color:var(--muted);font-size:1.05rem}.inline-visual{grid-column:2/-1;margin-top:2rem}.media-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:3rem}.media-heading>p:last-child{margin:0;color:var(--muted)}.media-pair{display:grid;grid-template-columns:.78fr 1.22fr;gap:clamp(1rem,3vw,3rem);align-items:end}.project-nav{display:grid;grid-template-columns:1fr 1fr}.project-nav a{display:flex;flex-direction:column;gap:1.5rem;padding:clamp(2rem,4vw,4rem) var(--gutter);transition:background var(--transition),color var(--transition)}.project-nav a:last-child{text-align:right;border-left:1px solid var(--line)}.project-nav a:hover{background:var(--ink);color:var(--paper)}.project-nav small{font-size:.65rem;letter-spacing:.1em;text-transform:uppercase}.project-nav span{font-family:var(--font-display);font-size:clamp(1.5rem,3vw,3.5rem);letter-spacing:-.035em}
@media(max-width:900px){.case-hero,.overview-grid{grid-template-columns:1fr}.case-index{flex-direction:row}.subtitle,.case-meta{grid-column:1}.case-meta dl{grid-template-columns:repeat(2,1fr);gap:1rem}.case-section{grid-template-columns:2rem 1fr}.case-section>p:last-of-type{grid-column:2}.inline-visual{grid-column:1/-1}.media-pair{grid-template-columns:1fr 1fr}}@media(max-width:600px){.case-hero h1{font-size:clamp(4rem,20vw,7rem)}.case-meta dl{grid-template-columns:1fr}.case-section{grid-template-columns:1fr;gap:1rem}.case-section>p:last-of-type{grid-column:1}.media-heading{display:block}.media-heading>p:last-child{margin-top:1rem}.media-pair,.project-nav{grid-template-columns:1fr}.project-nav a:last-child{border-left:0;border-top:1px solid var(--line);text-align:left}}
</style>

