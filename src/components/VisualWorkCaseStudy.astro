---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

import agendaToBackcover from '../assets/projects/visual/AGENDA-TO-BACKCOVER.png';
import cfoCocktail from "../assets/projects/visual/CFO's Networking Cocktail & Dinner_N.png";
import cfo2025 from '../assets/projects/visual/CFO_2025.jpg';
import cfoGeneral from '../assets/projects/visual/F4.png';
import foisLetterhead from '../assets/projects/visual/FOISG_LH_FOIS_LH.png';
import foisGeneral from '../assets/projects/visual/FOIS_GF.jpg';
import foisSpeakers from '../assets/projects/visual/FOIS_GSF_b1.jpg';
import foisLandscape from '../assets/projects/visual/FOIS_LnB.png';
import futureOfFood from '../assets/projects/visual/FUTUREOFFOOD.png';
import gcooIntro from '../assets/projects/visual/gcoo-cover-intro.png';
import gcooClosing from '../assets/projects/visual/gcoo-last.png';
import raceLetterhead from '../assets/projects/visual/ghana_race_2030_letterhead_preview.png';
import raceBackground from '../assets/projects/visual/GRT2030_background.png';
import raceConclusion from '../assets/projects/visual/GRT2030_counclusion.png';
import raceCoverToSummary from '../assets/projects/visual/GRT2030_cover-to-summary.png';
import raceCover from '../assets/projects/visual/GRT2030_cover.png';
import raceFormatToRoundtables from '../assets/projects/visual/GRT2030_format-to-roundtables.png';
import raceOutcomesToFormat from '../assets/projects/visual/GRT2030_outcomes-to-format.png';
import raceSummaryToObjectives from '../assets/projects/visual/GRT2030_summary-to-objectives.png';
import raceTheme from '../assets/projects/visual/GRT2030_theme.png';
import pslsLetterhead from '../assets/projects/visual/PSLS_letterhead_2026-01.png';
import cfoSpeaker from '../assets/projects/visual/ST_ALA_CFO26.png';
import womenInFinance from '../assets/projects/visual/WIFSG_COVER-TO-PROFILE.png';

interface Props { previous: Project; next: Project; }
const { previous, next } = Astro.props;
---

<article class="visual-case">
  <header class="case-hero shell reveal">
    <div class="case-index"><p class="eyebrow">Case study / 04</p><a href="/work/">All work ↗</a></div>
    <div class="hero-title"><h1 class="display">Selected Visual Work</h1><p>Brochures, Campaigns &amp; Corporate Collateral</p></div>
    <div class="case-meta">
      <dl>
        <div><dt>Focus</dt><dd>Selected professional work</dd></div>
        <div><dt>Disciplines</dt><dd>Editorial design<br />Campaign design<br />Corporate collateral<br />Digital creative</dd></div>
        <div><dt>Contribution</dt><dd>Design execution, layout systems and multi-format adaptation</dd></div>
        <div><dt>Formats</dt><dd>Publication, print and digital</dd></div>
      </dl>
    </div>
  </header>

  <section class="hero-art shell" aria-label="Selected Visual Work hero composition">
    <figure class="art hero-cover"><Image src={raceCover} alt="Ghana Race to 2030 Leadership Summit publication cover" layout="constrained" quality="high" priority /><figcaption><span>Publication design</span><span>Cover</span></figcaption></figure>
    <figure class="art hero-sequence"><Image src={raceCoverToSummary} alt="Opening page sequence from the Ghana Race to 2030 publication" layout="full-width" quality="high" /><figcaption><span>Ghana Race to 2030</span><span>Opening sequence</span></figcaption></figure>
  </section>

  <section class="overview section">
    <div class="shell overview-grid"><p class="eyebrow">Project overview</p><p>A curated selection of editorial, campaign and corporate design work created across executive events and professional communications.</p></div>
  </section>

  <section class="editorial section shell" aria-labelledby="editorial-title">
    <div class="section-intro">
      <p class="eyebrow">01 / Editorial design</p>
      <div><h2 id="editorial-title">A publication system built page by page.</h2><p>The Ghana Race to 2030 publication moves from a highly recognisable cover into structured, information-dense sections. Repeated typographic, colour and diagram systems create continuity without making every page behave the same way.</p><p class="credit">Design work presented as Samuel Akorta’s professional contribution for Evoke Impact and its event portfolio.</p></div>
    </div>
    <div class="editorial-portraits">
      <figure class="art background-page"><Image src={raceBackground} alt="Background and rationale page from the Ghana Race to 2030 publication" layout="constrained" quality="high" /><figcaption><span>Background + rationale</span><span>Structured information</span></figcaption></figure>
      <figure class="art theme-page"><Image src={raceTheme} alt="Summit theme page from the Ghana Race to 2030 publication" layout="constrained" quality="high" /><figcaption><span>Summit theme</span><span>Section transition</span></figcaption></figure>
    </div>
    <div class="publication-sequence">
      <figure class="art spread spread--wide"><Image src={raceSummaryToObjectives} alt="Executive summary, background, theme and objectives sequence from the Ghana Race to 2030 publication" layout="full-width" quality="high" /><figcaption><span>Editorial sequence / 01</span><span>Summary to objectives</span></figcaption></figure>
      <figure class="art spread spread--offset"><Image src={raceOutcomesToFormat} alt="Outcomes, participants and summit format sequence from the Ghana Race to 2030 publication" layout="full-width" quality="high" /><figcaption><span>Editorial sequence / 02</span><span>Outcomes to format</span></figcaption></figure>
      <figure class="art spread spread--compact"><Image src={raceFormatToRoundtables} alt="Summit format, impact showcase and leadership roundtables sequence from the Ghana Race to 2030 publication" layout="full-width" quality="high" /><figcaption><span>Editorial sequence / 03</span><span>Format to roundtables</span></figcaption></figure>
    </div>
  </section>

  <section class="brochures section rule" aria-labelledby="brochures-title">
    <div class="shell section-intro compact">
      <p class="eyebrow">02 / Brochures across identities</p>
      <div><h2 id="brochures-title">Different subjects require different editorial voices.</h2><p>Each publication balances event information, brand character and page-to-page clarity differently. The layout system responds to the material rather than imposing one house style.</p></div>
    </div>
    <div class="shell brochure-grid">
      <figure class="art brochure-food"><Image src={futureOfFood} alt="Future of Food Summit brochure sequence with magenta typography and food photography" layout="full-width" quality="high" /><figcaption><span>Future of Food Summit</span><span>Brochure sequence</span></figcaption></figure>
      <figure class="art brochure-wif"><Image src={womenInFinance} alt="Women in Finance Summit brochure opening sequence in purple and red" layout="full-width" quality="high" /><figcaption><span>Women in Finance Summit</span><span>Cover to profile</span></figcaption></figure>
      <figure class="art brochure-agenda"><Image src={agendaToBackcover} alt="Women in Finance Summit agenda and back-cover page sequence" layout="full-width" quality="high" /><figcaption><span>Women in Finance Summit</span><span>Agenda to back cover</span></figcaption></figure>
      <figure class="art brochure-gcoo"><Image src={gcooIntro} alt="Ghana COO Summit concept publication opening sequence" layout="full-width" quality="high" /><figcaption><span>Ghana COO Summit</span><span>Cover + introduction</span></figcaption></figure>
      <figure class="art brochure-gcoo-closing"><Image src={gcooClosing} alt="Ghana COO Summit publication closing sequence with objectives, agenda themes and back cover" layout="full-width" quality="high" /><figcaption><span>Ghana COO Summit</span><span>Closing sequence</span></figcaption></figure>
    </div>
  </section>

  <section class="campaign section" aria-labelledby="campaign-title">
    <div class="shell campaign-heading">
      <p class="eyebrow">03 / Campaign communication</p>
      <h2 id="campaign-title">A message changes shape as an event approaches.</h2>
      <p>General event information, programme themes and speaker-led promotion each ask for a different emphasis while remaining visibly part of the same campaign.</p>
    </div>
    <div class="shell fois-system">
      <figure class="art fois-general"><Image src={foisGeneral} alt="Future of Insurance Summit general promotional graphic" layout="constrained" quality="high" /><figcaption><span>General promotion</span><span>Event information</span></figcaption></figure>
      <figure class="art fois-speakers"><Image src={foisSpeakers} alt="Future of Insurance Summit speaker and programme promotional graphic" layout="constrained" quality="high" /><figcaption><span>Programme promotion</span><span>Speaker group</span></figcaption></figure>
      <figure class="art fois-landscape"><Image src={foisLandscape} alt="Future of Insurance Summit landscape campaign graphic with venue and date information" layout="full-width" quality="high" /><figcaption><span>Format adaptation</span><span>Landscape campaign asset</span></figcaption></figure>
    </div>
  </section>

  <section class="cfo-system section rule" aria-labelledby="cfo-title">
    <div class="shell section-intro compact">
      <p class="eyebrow">04 / Campaign systems</p>
      <div><h2 id="cfo-title">One campaign, many messages.</h2><p>A shared visual language adapts from broad event promotion to an individual speaker announcement and a related networking activation, keeping each communication useful without losing campaign recognition.</p></div>
    </div>
    <div class="shell cfo-grid">
      <figure class="art cfo-main"><Image src={cfoGeneral} alt="Ghana CFO Summit general campaign flyer with event benefits and registration information" layout="constrained" quality="high" /><figcaption><span>General promotion</span><span>Ghana CFO Summit</span></figcaption></figure>
      <figure class="art cfo-speaker"><Image src={cfoSpeaker} alt="Ghana CFO Summit keynote speaker announcement for Albert Larweh Asante" layout="constrained" quality="high" /><figcaption><span>Speaker announcement</span><span>Campaign adaptation</span></figcaption></figure>
      <figure class="art cfo-activation"><Image src={cfoCocktail} alt="CFO Circle networking cocktail and dinner promotional flyer" layout="constrained" quality="high" /><figcaption><span>Event activation</span><span>Networking communication</span></figcaption></figure>
    </div>
  </section>

  <section class="range section" aria-labelledby="range-title">
    <div class="shell range-grid">
      <div class="range-copy"><p class="eyebrow">05 / Different identities</p><h2 id="range-title">Different communication needs. Different visual solutions.</h2><p>The work moves between finance, food systems, public leadership, insurance and executive events. The design contribution is shaped around the needs of each format and campaign rather than forcing unrelated projects into one visual language.</p></div>
      <figure class="art range-art"><Image src={cfo2025} alt="Ghana CFO Summit 2025 multi-speaker event flyer" layout="constrained" quality="high" /><figcaption><span>Ghana CFO Summit 2025</span><span>Multi-speaker programme</span></figcaption></figure>
    </div>
  </section>

  <section class="collateral section rule" aria-labelledby="collateral-title">
    <div class="shell section-intro">
      <p class="eyebrow">06 / Corporate collateral</p>
      <div><h2 id="collateral-title">Visual consistency in practical communication.</h2><p>Campaign systems also extend into professional documents, where hierarchy and brand recognition need to work within quieter, functional formats.</p></div>
    </div>
    <div class="shell collateral-grid">
      <figure class="art letterhead-race"><Image src={raceLetterhead} alt="Ghana Race to 2030 Leadership Summit letterhead" layout="constrained" quality="high" /><figcaption><span>Ghana Race to 2030</span><span>Letterhead</span></figcaption></figure>
      <figure class="art letterhead-fois"><Image src={foisLetterhead} alt="Future of Insurance Summit landscape letterhead" layout="full-width" quality="high" /><figcaption><span>Future of Insurance Summit</span><span>Corporate collateral</span></figcaption></figure>
      <figure class="art letterhead-psls"><Image src={pslsLetterhead} alt="Ghana Public Sector Leaders Summit landscape letterhead" layout="full-width" quality="high" /><figcaption><span>Public Sector Leaders Summit</span><span>Corporate collateral</span></figcaption></figure>
    </div>
  </section>

  <section class="principles section" aria-labelledby="principles-title">
    <div class="shell principles-grid">
      <div><p class="eyebrow">07 / Design practice</p><h2 id="principles-title">Clarity gives the visual system room to work.</h2></div>
      <div class="principles-list"><p><span>01</span>Build hierarchy around the information people need first</p><p><span>02</span>Use typography to create pace across dense material</p><p><span>03</span>Keep repeated formats consistent without becoming mechanical</p><p><span>04</span>Adapt a system without losing recognition</p></div>
    </div>
  </section>

  <section class="final-statement section rule" aria-labelledby="final-title">
    <div class="shell final-heading"><p class="eyebrow">08 / Final visual statement</p><div><h2 id="final-title">The format changes. The objective stays the same.</h2><p>Communicate clearly, build hierarchy and make the visual system hold together.</p></div></div>
    <figure class="art final-art"><Image src={raceConclusion} alt="Closing publication sequence from the Ghana Race to 2030 Leadership Summit document" layout="full-width" quality="high" /><figcaption><span>Ghana Race to 2030</span><span>Closing publication sequence</span></figcaption></figure>
  </section>

  <nav class="project-nav rule" aria-label="Project navigation">
    <a href={`/work/${previous.slug}/`}><small>Previous project</small><span>← {previous.title}</span></a>
    <a href={`/work/${next.slug}/`}><small>Next project</small><span>{next.title} →</span></a>
  </nav>
</article>

<style>
  .visual-case { overflow: clip; }
  .case-hero { padding-block: clamp(3.5rem, 8vw, 8rem); display: grid; grid-template-columns: 1fr 3fr; gap: 1rem 4rem; }
  .case-index { display: flex; flex-direction: column; justify-content: space-between; padding-bottom: .8rem; }
  .case-index a { color: var(--muted); font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; }
  .hero-title h1 { max-width: 9ch; font-size: clamp(4rem, 10.5vw, 10.5rem); }
  .hero-title > p { max-width: 49rem; margin: 1.2rem 0 0; font-family: var(--font-display); font-size: clamp(1.7rem, 3vw, 3rem); line-height: 1.05; letter-spacing: -.035em; }
  .case-meta { grid-column: 2; margin-top: 4rem; }
  .case-meta dl { margin: 0; display: grid; grid-template-columns: 1fr 1.7fr 1.7fr 1fr; border-top: 1px solid var(--ink); }
  .case-meta dl div { padding: 1rem 1rem 0 0; }
  .case-meta dt { margin-bottom: .5rem; color: var(--muted); font-size: .62rem; letter-spacing: .09em; text-transform: uppercase; }
  .case-meta dd { margin: 0; font-size: .78rem; line-height: 1.5; }
  figure { min-width: 0; margin: 0; }
  .art :global(img) { display: block; width: 100%; max-width: 100%; height: auto; object-fit: contain; }
  figcaption { display: flex; justify-content: space-between; gap: 1rem; margin-top: .8rem; color: var(--muted); font-size: .62rem; line-height: 1.35; letter-spacing: .09em; text-transform: uppercase; }
  .hero-art { display: grid; grid-template-columns: 2.4fr 8fr; gap: clamp(1.25rem, 3vw, 3.5rem); align-items: end; }
  .hero-cover { position: relative; z-index: 1; }
  .hero-cover :global(img) { box-shadow: 0 1.5rem 4rem rgba(27, 23, 18, .14); }
  .hero-sequence { margin-bottom: 5vw; }
  .overview { margin-top: clamp(5rem, 10vw, 10rem); background: var(--ink); color: var(--paper); }
  .overview-grid { display: grid; grid-template-columns: 1fr 3fr; gap: 4rem; }
  .overview-grid > p:last-child { max-width: 70rem; margin: -.2em 0 0; font-family: var(--font-display); font-size: clamp(2.3rem, 5vw, 5rem); line-height: 1.02; letter-spacing: -.045em; }
  .section-intro { display: grid; grid-template-columns: 1fr 3fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; margin-bottom: clamp(3rem, 6vw, 6rem); }
  .section-intro.compact { grid-template-columns: 1fr 2fr; }
  .section-intro h2, .campaign-heading h2, .range-copy h2, .principles-grid h2, .final-heading h2 { margin: -.12em 0 1.5rem; font-family: var(--font-display); font-size: clamp(2.7rem, 5vw, 5.5rem); font-weight: 400; line-height: .98; letter-spacing: -.05em; }
  .section-intro > div > p, .campaign-heading > p:last-child, .range-copy > p:last-child, .final-heading > div > p { max-width: 44rem; margin: 0 0 1rem; color: var(--muted); font-size: 1.05rem; }
  .credit { font-size: .72rem !important; line-height: 1.55; letter-spacing: .035em; }
  .editorial-portraits { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 8vw, 10rem); width: min(76%, 1020px); margin-inline: auto; align-items: start; }
  .theme-page { margin-top: 10vw; }
  .publication-sequence { margin-top: clamp(5rem, 10vw, 10rem); display: grid; gap: clamp(4rem, 8vw, 9rem); }
  .spread--wide { width: 100%; }
  .spread--offset { width: 88%; margin-left: auto; }
  .spread--compact { width: 82%; }
  .brochures { background: #252227; color: #f7f0e7; }
  .brochures .section-intro p, .brochures figcaption { color: #bbb3b8; }
  .brochure-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: clamp(4rem, 8vw, 9rem) clamp(1rem, 3vw, 3rem); align-items: start; }
  .brochure-food { grid-column: 1 / 13; }
  .brochure-wif { grid-column: 2 / 12; }
  .brochure-agenda { grid-column: 5 / 13; }
  .brochure-gcoo { grid-column: 1 / 11; }
  .brochure-gcoo-closing { grid-column: 3 / 13; }
  .campaign { background: #dfe8e7; }
  .campaign-heading { display: grid; grid-template-columns: 1fr 2fr 1fr; gap: clamp(2rem, 4vw, 4rem); margin-bottom: clamp(4rem, 7vw, 7rem); }
  .fois-system { display: grid; grid-template-columns: .8fr 1fr; gap: clamp(2rem, 6vw, 7rem); align-items: start; }
  .fois-general { width: 76%; margin-top: 9vw; }
  .fois-speakers { width: 82%; margin-left: auto; }
  .fois-landscape { grid-column: 1 / -1; width: 84%; margin: 1rem auto 0; }
  .cfo-system { background: #f4eee5; }
  .cfo-grid { display: grid; grid-template-columns: 1.05fr 1fr .65fr; gap: clamp(1.5rem, 4vw, 5rem); align-items: start; }
  .cfo-main { width: 88%; }
  .cfo-speaker { margin-top: 9vw; }
  .cfo-activation { margin-top: 3vw; }
  .range { background: #a2462f; color: #fff8f0; }
  .range-grid { display: grid; grid-template-columns: 1.5fr .65fr; gap: clamp(4rem, 10vw, 12rem); align-items: center; }
  .range-copy > p:last-child { color: #f0d8cf; }
  .range-art figcaption { color: #f0d8cf; }
  .collateral-grid { display: grid; grid-template-columns: 2fr 5fr; gap: clamp(3rem, 7vw, 8rem) clamp(2rem, 5vw, 6rem); align-items: center; }
  .letterhead-race { grid-row: 1 / 3; width: 88%; }
  .letterhead-fois, .letterhead-psls { padding: clamp(.5rem, 1vw, 1rem); background: #fff; }
  .principles { background: var(--ink); color: var(--paper); }
  .principles-grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(4rem, 10vw, 11rem); }
  .principles-list { border-top: 1px solid #514f4a; }
  .principles-list p { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; margin: 0; padding-block: 1.2rem; border-bottom: 1px solid #514f4a; font-size: .92rem; }
  .principles-list span { color: #aaa79f; font-size: .68rem; }
  .final-heading { display: grid; grid-template-columns: 1fr 3fr; gap: clamp(2rem, 5vw, 5rem); margin-bottom: clamp(4rem, 7vw, 7rem); }
  .final-art { width: min(94%, 1760px); margin-left: auto; padding: clamp(.5rem, 1vw, 1rem); background: #5e5e5e; }
  .final-art figcaption { color: #d4d0c9; }
  .project-nav { display: grid; grid-template-columns: 1fr 1fr; }
  .project-nav a { display: flex; flex-direction: column; gap: 1.5rem; padding: clamp(2rem, 4vw, 4rem) var(--gutter); transition: background var(--transition), color var(--transition); }
  .project-nav a:last-child { text-align: right; border-left: 1px solid var(--line); }
  .project-nav a:hover { background: var(--ink); color: var(--paper); }
  .project-nav small { font-size: .65rem; letter-spacing: .1em; text-transform: uppercase; }
  .project-nav span { font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 3.5rem); letter-spacing: -.035em; }

  @media (max-width: 1000px) {
    .case-hero, .overview-grid { grid-template-columns: 1fr; }
    .case-index { flex-direction: row; }
    .case-meta { grid-column: 1; }
    .case-meta dl { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
    .campaign-heading { grid-template-columns: 1fr 2fr; }
    .campaign-heading > p:last-child { grid-column: 2; }
    .cfo-grid { grid-template-columns: 1fr 1fr; }
    .cfo-activation { grid-column: 2; width: 68%; margin: 0 auto; }
  }
  @media (max-width: 760px) {
    .case-hero { gap: 2.5rem; }
    .hero-title h1 { font-size: clamp(4rem, 18vw, 7rem); }
    .case-meta { margin-top: 1rem; }
    .hero-art { grid-template-columns: .42fr 1fr; gap: 1rem; }
    .hero-sequence { margin-bottom: 1rem; }
    .section-intro, .section-intro.compact, .campaign-heading, .range-grid, .principles-grid, .final-heading { grid-template-columns: 1fr; gap: 2rem; }
    .campaign-heading > p:last-child { grid-column: 1; }
    .editorial-portraits { width: 100%; gap: 1.5rem; }
    .theme-page { margin-top: 4rem; }
    .publication-sequence { gap: 4rem; }
    .spread--offset, .spread--compact { width: 100%; }
    .brochure-grid { grid-template-columns: minmax(0, 1fr); gap: 4rem; }
    .brochure-food, .brochure-wif, .brochure-agenda, .brochure-gcoo, .brochure-gcoo-closing { grid-column: 1; width: 100%; }
    .fois-system { gap: 1.5rem; }
    .fois-general, .fois-speakers { width: 100%; margin: 0; }
    .fois-general { margin-top: 3rem; }
    .fois-landscape { width: 100%; }
    .range-art { width: 58%; margin-inline: auto; }
    .collateral-grid { grid-template-columns: .7fr 1.3fr; gap: 3rem 1.5rem; }
    .letterhead-race { grid-row: 1 / 3; width: 100%; }
  }
  @media (max-width: 520px) {
    .case-meta dl { grid-template-columns: 1fr; }
    .hero-art { grid-template-columns: 1fr; }
    .hero-cover { width: 58%; margin-inline: auto; }
    .hero-sequence { margin: 2rem 0 0; }
    .overview-grid > p:last-child { font-size: 2.25rem; }
    .editorial-portraits { grid-template-columns: 1fr; gap: 3rem; }
    .background-page, .theme-page { width: 78%; margin: 0 auto; }
    .publication-sequence { margin-top: 4rem; }
    .publication-sequence .spread, .brochure-grid .art { max-width: 100%; overflow-x: auto; overscroll-behavior-inline: contain; scrollbar-width: thin; }
    .publication-sequence :global(img), .brochure-grid :global(img) { width: max(100%, 52rem); max-width: none; height: auto !important; aspect-ratio: auto !important; object-fit: contain !important; }
    .fois-system { grid-template-columns: 1fr; gap: 3rem; }
    .fois-general, .fois-speakers { width: 74%; margin-inline: auto; }
    .fois-landscape { grid-column: 1; }
    .cfo-grid { grid-template-columns: 1fr; gap: 3rem; }
    .cfo-main, .cfo-speaker { width: 78%; margin: 0 auto; }
    .cfo-activation { grid-column: 1; width: 62%; margin-inline: auto; }
    .range-art { width: 70%; }
    .collateral-grid { grid-template-columns: 1fr; gap: 3rem; }
    .letterhead-race { grid-row: auto; width: 68%; margin-inline: auto; }
    .letterhead-fois, .letterhead-psls { width: 100%; }
    .final-art { width: 100%; padding-inline: var(--gutter); background: transparent; }
    .final-art figcaption { color: var(--muted); }
    figcaption { font-size: .55rem; }
    .project-nav { grid-template-columns: 1fr; }
    .project-nav a:last-child { border-left: 0; border-top: 1px solid var(--line); text-align: left; }
  }
</style>
